#!/bin/sh
# Sleep, My Sweetie — safe, cancellable systemd power-off command.
set -eu
VERSION=1.2.0
PROGRAM_NAME=${0##*/}
SHUTDOWN=${SLEEP_MY_SWEETIE_SHUTDOWN:-/usr/sbin/shutdown}
GNOME_SESSION_QUIT=${SLEEP_MY_SWEETIE_GNOME_SESSION_QUIT:-/usr/bin/gnome-session-quit}
RUNUSER=/usr/sbin/runuser
TEST_MODE=${SLEEP_MY_SWEETIE_TEST_MODE:-0}

show_help() {
    cat <<'HELP'
Sleep, My Sweetie

Usage:
  sudo sleep_my_sweetie
  sudo goodnight_my_love
  sudo off_you_go
  sudo night_night
  sudo rest_in_peace
  sudo bye_bye_baby
  sudo shut_down_sweetheart
  sudo time_to_sleep

Options:
  -h, --help    Show this help message and exit
  -V, --version Show the program version and exit
  --doctor      Check the local shutdown environment without powering off
  --dry-run     Show what would happen without powering off

The command displays a five-second countdown. In an active GNOME desktop
session it asks GNOME to show its standard power-off confirmation; otherwise
it uses the standard shutdown command. Press Ctrl+C during the countdown to cancel.

SLEEP_MY_SWEETIE_SHUTDOWN, SLEEP_MY_SWEETIE_GNOME_SESSION_QUIT,
SLEEP_MY_SWEETIE_RUNTIME_DIR, and SLEEP_MY_SWEETIE_TEST_MODE are intended
for automated tests only.
HELP
}

if [ "$#" -gt 1 ]; then
    printf 'Error: too many arguments.\n\n' >&2
    show_help >&2
    exit 2
fi

DOCTOR=0
case "${1-}" in
    -h|--help) show_help; exit 0 ;;
    -V|--version) printf 'Sleep, My Sweetie %s\n' "$VERSION"; exit 0 ;;
    --doctor) DOCTOR=1; DRY_RUN=0 ;;
    --dry-run) DRY_RUN=1 ;;
    "") DRY_RUN=0 ;;
    *)
        printf 'Error: unknown argument: %s\n\n' "$1" >&2
        show_help >&2
        exit 2
        ;;
esac

# sudo sets SUDO_USER to the account that launched the command. Resolve that
# account instead of assuming a fixed UID such as 1000.
CALLING_USER=${SUDO_USER:-$(id -un)}
CALLING_UID=$(id -u "$CALLING_USER" 2>/dev/null || true)
RUNTIME_DIR=${SLEEP_MY_SWEETIE_RUNTIME_DIR:-/run/user/${CALLING_UID:-0}}
GNOME_AVAILABLE=0
if [ -n "$CALLING_UID" ] && [ "$CALLING_UID" -gt 0 ] 2>/dev/null &&
    [ -S "$RUNTIME_DIR/bus" ] && [ -x "$GNOME_SESSION_QUIT" ]; then
    GNOME_AVAILABLE=1
fi

run_doctor() {
    doctor_status=0
    printf 'Sleep, My Sweetie diagnostic report\n'
    printf 'Version: %s\n' "$VERSION"
    printf 'Command path: %s\n' "$0"
    printf 'Current user: %s (uid %s)\n' "$(id -un)" "$(id -u)"
    printf 'Desktop user: %s\n' "$CALLING_USER"
    printf 'Desktop: %s\n' "${XDG_CURRENT_DESKTOP:-not set}"
    printf 'Session type: %s\n' "${XDG_SESSION_TYPE:-not set}"

    if [ "$GNOME_AVAILABLE" -eq 1 ]; then
        printf '[OK] GNOME session bus socket found: %s/bus\n' "$RUNTIME_DIR"
        printf '[OK] GNOME session command is executable: %s\n' "$GNOME_SESSION_QUIT"
        if [ -x "$RUNUSER" ]; then
            printf '[OK] runuser is executable: %s\n' "$RUNUSER"
            printf 'Selected power-off route: GNOME confirmation dialog\n'
        else
            printf '[ERROR] runuser is missing or not executable: %s\n' "$RUNUSER" >&2
            doctor_status=1
        fi
    else
        printf '[INFO] No usable GNOME session bus detected for %s.\n' "$CALLING_USER"
        if [ -x "$SHUTDOWN" ]; then
            printf '[OK] Standard shutdown command is executable: %s\n' "$SHUTDOWN"
            printf 'Selected power-off route: standard shutdown command (-h now)\n'
        else
            printf '[ERROR] Shutdown command is missing or not executable: %s\n' "$SHUTDOWN" >&2
            doctor_status=1
        fi
    fi
    printf 'No power-off request was made.\n'
    return "$doctor_status"
}

if [ "$DOCTOR" -eq 1 ]; then
    run_doctor
    exit $?
fi

printf '\nGoodnight, my sweetie. ❤️\n'
printf "You've worked hard today.\n"
printf 'Time to rest.\n\n'

if [ "$DRY_RUN" -eq 1 ]; then
    printf 'Dry run: no shutdown will be requested.\n'
    if [ "$GNOME_AVAILABLE" -eq 1 ]; then
        printf 'Would request GNOME power-off confirmation for user: %s\n' "$CALLING_USER"
    else
        printf 'Would execute: %s -h now\n' "$SHUTDOWN"
    fi
    exit 0
fi

# This test-only switch allows CI to exercise the request flow without root.
if [ "$(id -u)" -ne 0 ] && [ "$TEST_MODE" != 1 ]; then
    printf 'Please run this command with sudo:\n  sudo %s\n' "$PROGRAM_NAME" >&2
    exit 1
fi

if [ "$GNOME_AVAILABLE" -eq 1 ]; then
    if [ "$TEST_MODE" != 1 ] && [ ! -x "$RUNUSER" ]; then
        printf 'Error: runuser executable not found: %s\n' "$RUNUSER" >&2
        exit 1
    fi
else
    if [ ! -x "$SHUTDOWN" ]; then
        printf 'Error: shutdown executable not found: %s\n' "$SHUTDOWN" >&2
        exit 1
    fi
fi

trap 'printf "\nShutdown cancelled. Your computer will stay on.\n" >&2; exit 130' INT
trap 'printf "\nShutdown interrupted by a termination signal.\n" >&2; exit 143' TERM

printf 'Powering off in 5 seconds. Press Ctrl+C to cancel.\n'
remaining=5
while [ "$remaining" -gt 0 ]; do
    printf '  %s...\n' "$remaining"
    sleep 1
    remaining=$((remaining - 1))
done

trap - INT TERM
printf 'Goodnight! ❤️\n'

if [ "$GNOME_AVAILABLE" -eq 1 ]; then
    printf 'Requesting power-off confirmation from GNOME for %s...\n' "$CALLING_USER"
    if [ "$TEST_MODE" = 1 ]; then
        if env XDG_RUNTIME_DIR="$RUNTIME_DIR" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME_DIR/bus" \
            "$GNOME_SESSION_QUIT" --power-off; then
            request_status=0
        else
            request_status=$?
        fi
    else
        if "$RUNUSER" -u "$CALLING_USER" -- env \
            XDG_RUNTIME_DIR="$RUNTIME_DIR" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME_DIR/bus" \
            "$GNOME_SESSION_QUIT" --power-off; then
            request_status=0
        else
            request_status=$?
        fi
    fi
    if [ "$request_status" -ne 0 ]; then
        printf 'GNOME power-off request was cancelled or failed (exit status %s).\n' "$request_status" >&2
        exit "$request_status"
    fi
    exit 0
fi

exec "$SHUTDOWN" -h now
